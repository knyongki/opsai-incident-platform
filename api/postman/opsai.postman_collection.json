          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const device = body.data || body;",
                  "pm.test('Returned ID matches device_id', () => pm.expect(device.id).to.eql(pm.collectionVariables.get('device_id')));"
