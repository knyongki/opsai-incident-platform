{
  "info": {
    "_postman_id": "b1822baf-458d-4614-b5c3-a56844ba4a88",
    "name": "OpsAI API",
    "description": "Postman collection for local OpsAI health, readiness, and device API testing. Run requests in order so Create Device stores device_id for later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('Status is ok', () => pm.expect(pm.response.json().data.status).to.eql('ok'));",
                  "pm.test('Health envelope is correct', () => pm.expect(pm.response.json()).to.deep.eql({data: {status: 'ok'}}));"
                ],
                "id": "59daad19-1e91-425e-b6e1-1dc2e43257e3"
              }
            }
          ],
          "id": "e9edffe8-606e-4d85-a42c-0273b2d1076e",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Checks whether the API process is running."
          },
          "response": []
        },
        {
          "name": "Readiness",
          "event": [
            {
              "listen": "test",
              "script": {
