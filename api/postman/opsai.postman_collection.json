    {
      "name": "Devices - Happy Path",
      "item": [
        {
          "name": "Create Device",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "const body = pm.response.json();",
                  "const device = body.data || body;",
                  "pm.test('Created device has an ID', () => pm.expect(device.id).to.be.a('string').and.not.empty);",
                  "if (device.id) pm.collectionVariables.set('device_id', device.id);"
                ],
                "id": "ae2a1302-1f3f-4cd7-bb5f-569ce6af3f7f"
              }
            }
          ],
          "id": "8d7187d6-31e6-453e-9675-eb3935e1d182",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AMR-07\",\n  \"type\": \"amr\",\n  \"location\": \"Warehouse A\",\n  \"status\": \"active\",\n  \"metadata\": {\n    \"manufacturer\": \"Demo Manufacturer\",\n    \"model\": \"AMR-X1\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/devices",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "devices"
              ]
            },
            "description": "Creates a device and stores its returned UUID in the collection variable device_id."
          },
          "response": []
        },
        {
          "name": "List Devices",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('Response contains data', () => pm.expect(pm.response.json()).to.have.property('data'));"
                ],
                "id": "ad84bd64-a5ce-475e-a043-df8771656930"
              }
            }
          ],
          "id": "8c7ac51b-7185-48db-88d3-c8d1eaf4588a",
