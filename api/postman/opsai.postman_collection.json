        {
          "name": "Update Device",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const device = body.data || body;",
                  "pm.test('Device was updated', () => {",
                  "  pm.expect(device.location).to.eql('Warehouse B');",
                  "  pm.expect(device.status).to.eql('maintenance');",
                  "});"
                ],
                "id": "12a9de6f-9f61-41a7-a745-bf18718f59ad"
