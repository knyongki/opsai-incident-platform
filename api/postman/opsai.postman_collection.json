                  "pm.test('Readiness envelope is correct', () => pm.expect(pm.response.json()).to.deep.eql({data: {status: 'ready'}}));"
                ],
                "id": "5ae64c80-d81f-4518-a194-f58cb3080b72"
              }
            }
          ],
          "id": "2006bedd-107b-4a0f-804f-0c4253fc87e5",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
