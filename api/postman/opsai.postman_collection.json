          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/devices/{{device_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "devices",
                "{{device_id}}"
              ]
            },
            "description": "Confirms the deleted device is no longer found."
          },
          "response": []
        }
