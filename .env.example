# Safe example values only. Copy to private .env for the PowerShell startup scripts.
# The Go API itself reads process environment variables.
APP_ENV=development
HTTP_ADDRESS=127.0.0.1:8080
LOG_LEVEL=INFO

# Public examples for a disposable localhost development database, not secrets.
POSTGRES_DB=opsai
POSTGRES_USER=opsai
POSTGRES_PASSWORD=local-example-only
POSTGRES_PORT=5432
DATABASE_URL=postgres://opsai:local-example-only@127.0.0.1:5432/opsai?sslmode=disable

# Optional worker settings. Fake mode requires explicit opt-in and a separate test database.
WORKER_ANALYZER=
WORKER_DATABASE_URL=
WORKER_FAKE_OUTCOME=success
WORKER_FAKE_DELAY=100ms
JOB_POLL_INTERVAL=1s
JOB_ATTEMPT_TIMEOUT=30s
JOB_LEASE=60s
JOB_DATABASE_TIMEOUT=5s
JOB_RETRY_BASE=2s
JOB_RETRY_CAP=60s
JOB_MAX_ATTEMPTS=3
WORKER_SHUTDOWN_TIMEOUT=10s
