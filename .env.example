# Safe example values only. Copy to private .env for the PowerShell startup scripts.
# The Go API itself reads process environment variables.
APP_ENV=development
HTTP_ADDRESS=127.0.0.1:8080
LOG_LEVEL=INFO

# Public examples for a disposable localhost development database, not secrets.
POSTGRES_DB=opsai
POSTGRES_USER=opsai
POSTGRES_PASSWORD=local-example-only
POSTGRES_PORT=5432
DATABASE_URL=postgres://opsai:local-example-only@127.0.0.1:5432/opsai?sslmode=disable

# Optional worker settings. WORKER_ANALYZER must be set explicitly to fake, claude,
# or openai.
# The isolated target uses a separate localhost database ending in _worker_test;
# main uses DATABASE_URL.
WORKER_ANALYZER=
WORKER_DATABASE_TARGET=isolated
WORKER_DATABASE_URL=

# Real analyzers (claude or openai). Each analysis sends incident and device
# details to that provider's API and is billed. Keep the real key only in private
# .env. The key belongs to the chosen provider. Leave WORKER_AI_MODEL empty for the
# claude default (claude-opus-5-5); openai requires a model.
WORKER_AI_API_KEY=
WORKER_AI_MODEL=
WORKER_AI_EFFORT=high
WORKER_FAKE_OUTCOME=success
WORKER_FAKE_DELAY=100ms
JOB_POLL_INTERVAL=1s
# Empty uses the analyzer's default: 30s/60s for fake, 120s/180s for claude and
# openai. Real analyzers reject an attempt timeout below 60s.
JOB_ATTEMPT_TIMEOUT=
JOB_LEASE=
JOB_DATABASE_TIMEOUT=5s
JOB_RETRY_BASE=2s
JOB_RETRY_CAP=60s
JOB_MAX_ATTEMPTS=3
WORKER_SHUTDOWN_TIMEOUT=10s
