# OpsAI local configuration template.
#
# Copy this file once to a private .env (Git-ignored) and change the values marked
# "SET YOUR OWN". Every value here is a safe public example, never a real secret.
#   PowerShell: if (-not (Test-Path .env)) { Copy-Item .env.example .env }
#
# Format: one KEY=VALUE per line, written literally (no quotes needed, no $VARIABLE
# expansion). Comments must be on their own line, never after a value.
# The scripts read this file and .env; the Go programs read only process
# environment variables, which the scripts set for them.
# Keys without a WORKER_ or JOB_ prefix are required in .env. WORKER_ and JOB_ keys
# are optional: when .env leaves one out, the value from this file is used.

# ---------------------------------------------------------------------------
# Application (read by the API and worker)
# ---------------------------------------------------------------------------

# Environment label. No behavior depends on it yet.
APP_ENV=development

# Host and port the API listens on. Keep localhost: the API has no authentication.
# Change the port if 8080 is taken, and update Postman's base_url to match.
HTTP_ADDRESS=127.0.0.1:8080

# Log level: DEBUG, INFO, WARN, or ERROR.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PostgreSQL (read by Docker Compose, the scripts, and the API)
# ---------------------------------------------------------------------------

# Database name, user, and password created by the container on its FIRST start.
# SET YOUR OWN password. Changing these later does not change an existing
# database; keep using the password the database was created with.
POSTGRES_DB=opsai
POSTGRES_USER=opsai
POSTGRES_PASSWORD=change-me-local-password

# Port on your computer that reaches the container (bound to 127.0.0.1 only).
POSTGRES_PORT=5432

# Connection URL for the API and migrations. It must match the four values above:
#   postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:<POSTGRES_PORT>/<POSTGRES_DB>?sslmode=disable
# SET YOUR OWN: use the same password as POSTGRES_PASSWORD. URL-encode special
# characters in the password (for example @ as %40).
DATABASE_URL=postgres://opsai:change-me-local-password@127.0.0.1:5432/opsai?sslmode=disable

# ---------------------------------------------------------------------------
# Worker (optional; read only by scripts/start-worker.ps1 and cmd/worker)
# ---------------------------------------------------------------------------

# Which analyzer the worker runs:
#   fake   - free deterministic test output; nothing leaves your computer
#   claude - real analysis by Anthropic Claude (needs an Anthropic API key; billed)
#   openai - real analysis by OpenAI (needs an OpenAI API key and model; billed)
WORKER_ANALYZER=fake

# Which database the worker processes:
#   isolated - the separate test database in WORKER_DATABASE_URL
#   main     - DATABASE_URL, the same database the API uses (results are permanent)
WORKER_DATABASE_TARGET=isolated

# Separate test database, used only when WORKER_DATABASE_TARGET=isolated. It must be
# on localhost and its name must end in _worker_test. Create it once (setup guide,
# "Isolated fake worker"). SET YOUR OWN: same user and password as above.
WORKER_DATABASE_URL=postgres://opsai:change-me-local-password@127.0.0.1:5432/opsai_worker_test?sslmode=disable

# ---------------------------------------------------------------------------
# Real AI analyzers (only used when WORKER_ANALYZER is claude or openai)
# Each analysis sends incident and device details to that provider and is billed.
# ---------------------------------------------------------------------------

# API key of the provider chosen in WORKER_ANALYZER. SET YOUR OWN, in .env only:
#   claude - an Anthropic key from console.anthropic.com
#   openai - an OpenAI key from platform.openai.com
# Never paste it into chat, commit it, or put a real key in this file.
WORKER_AI_API_KEY=replace-with-your-provider-api-key

# Model ID for the chosen provider (the model's name, not a project or account ID):
#   claude - for example claude-opus-5-5 (used when this is empty)
#   openai - required; for example gpt-5.4-mini. The model must support the
#            Responses API and structured outputs.
WORKER_AI_MODEL=claude-opus-5-5

# Reasoning effort: low, medium, high, xhigh, or max. The model must support it.
WORKER_AI_EFFORT=high

# ---------------------------------------------------------------------------
# Fake analyzer (only used when WORKER_ANALYZER=fake)
# ---------------------------------------------------------------------------

# Simulated outcome: success, transient, transient-once, permanent, or invalid-output.
WORKER_FAKE_OUTCOME=success

# Simulated analysis time, for example 100ms or 5s (5s makes "analyzing" visible).
WORKER_FAKE_DELAY=100ms

# ---------------------------------------------------------------------------
# Job queue and retries (optional; the defaults suit every analyzer)
# Durations use Go format: 500ms, 30s, 2m. Restart the worker after changes.
# ---------------------------------------------------------------------------

# Wait between checks when the queue is empty.
JOB_POLL_INTERVAL=1s

# Deadline for one analysis attempt. Real analyzers need at least 60s.
JOB_ATTEMPT_TIMEOUT=120s

# How long a worker owns a claimed job. Must exceed
# JOB_ATTEMPT_TIMEOUT + 3 x JOB_DATABASE_TIMEOUT (120s + 15s here).
JOB_LEASE=180s

# Deadline for each database operation of the worker.
JOB_DATABASE_TIMEOUT=5s

# First retry delay, doubled on each retry up to JOB_RETRY_CAP.
JOB_RETRY_BASE=2s
JOB_RETRY_CAP=60s

# Maximum attempts per job (1-100); after that the incident becomes analysis_failed.
JOB_MAX_ATTEMPTS=3

# Maximum wait for running work after Ctrl+C before the worker exits.
WORKER_SHUTDOWN_TIMEOUT=10s
